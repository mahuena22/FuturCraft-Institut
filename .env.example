# Copiez ce fichier en .env.local (dÃ©veloppement) ou .env.production (dÃ©ploiement Vercel)
# et renseignez vos vraies valeurs.

# Base de donnÃ©es PostgreSQL (locale en dev, Neon serverless en production)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Secrets et auth (obligatoires)
ADMIN_PASSWORD=votre-mot-de-passe-admin
SESSION_SECRET=change-me-with-a-long-random-secret
CRON_SECRET=change-me-with-a-long-random-secret

# Redis (optionnel â€” requis pour le rate-limit distribuÃ© en production multi-instance)
# Si non renseignÃ©, le rate-limit utilise un stockage en mÃ©moire (perdu au redÃ©marrage).
# Exemple Upstash : REDIS_URL=rediss://...@...upstash.io
REDIS_URL=redis://localhost:6379

# Emails (optionnel â€” sans cette clÃ©, les notifications sont journalisÃ©es)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Uploads durables (Vercel Blob). Sans token, fallback stockage local public/uploads.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

