# Copiez ce fichier en .env.local (développement) ou .env.production (déploiement Vercel)
# et renseignez vos vraies valeurs.

# Base de données PostgreSQL (locale en dev, Neon serverless en production)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Mot de passe du tableau de bord admin
ADMIN_PASSWORD=votre-mot-de-passe-admin
