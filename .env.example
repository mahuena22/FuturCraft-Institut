# Copiez ce fichier en .env.local (développement) ou .env.production (déploiement Vercel)
# et renseignez vos vraies valeurs.

# Base de données PostgreSQL (locale en dev, Neon serverless en production)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Mot de passe du tableau de bord admin
ADMIN_PASSWORD=votre-mot-de-passe-admin

# Redis (optionnel — requis pour le rate-limit distribué en production multi-instance)
# Si non renseigné, le rate-limit utilise un stockage en mémoire (perdu au redémarrage).
# Exemple Upstash : REDIS_URL=rediss://...@...upstash.io
REDIS_URL=redis://localhost:6379
